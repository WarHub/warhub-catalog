{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://warhub.github.io/warhub-catalog/schema/product-catalog.json",
  "title": "WarHub Product Catalog",
  "description": "A consolidated or per-game-system product catalog document.",
  "type": "object",
  "required": ["schemaVersion", "kind", "version", "generatedAt", "counts", "source", "products"],
  "properties": {
    "schemaVersion": { "type": "string" },
    "kind": { "enum": ["product-catalog", "product-catalog-partition"] },
    "version": { "type": "string" },
    "generatedAt": { "type": "string" },
    "gitCommit": { "type": "string" },
    "partition": { "$ref": "#/$defs/partition" },
    "counts": { "type": "object", "additionalProperties": { "type": "integer" } },
    "source": { "$ref": "#/$defs/source" },
    "products": { "type": "array", "items": { "$ref": "#/$defs/product" } }
  },
  "$defs": {
    "product": {
      "type": "object",
      "required": ["id", "manufacturer", "name", "quantity"],
      "properties": {
        "id": { "type": "string" },
        "manufacturer": { "type": "string" },
        "ean": { "type": "string" },
        "additionalEans": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "supersedes": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "supersededBy": { "type": "string" },
        "paintIds": {
          "type": "array",
          "description": "Paint records sharing a barcode with this product -- the same physical thing published in the paint catalog too. Omitted when there is none. See barcode-index.json; ids are stable within a release.",
          "items": { "type": "string" },
          "minItems": 1
        },
        "eanConfidence": { "type": "string", "enum": ["confirmed", "provisional", "conflicted"] },
        "priceGbp": { "type": "number" },
        "priceUsd": { "type": "number" },
        "priceEur": { "type": "number" },
        "priceCad": { "type": "number" },
        "name": { "type": "string" },
        "gameSystem": { "type": ["string", "null"] },
        "faction": { "type": "string" },
        "category": { "type": "string" },
        "status": { "type": "string" },
        "availability": { "type": "string" },
        "quantity": { "type": "integer", "minimum": 1 },
        "volumeMl": { "type": "integer", "minimum": 1 },
        "productCode": { "type": "string" },
        "url": { "type": "string" },
        "imageUrl": { "type": "string" }
      }
    },
    "partition": {
      "type": "object",
      "required": ["type", "key", "label"],
      "properties": {
        "type": { "type": "string" },
        "key": { "type": "string" },
        "label": { "type": "string" }
      }
    },
    "source": {
      "type": "object",
      "required": ["repo"],
      "properties": {
        "repo": { "type": "string" },
        "release": {
          "type": "object",
          "required": ["tag", "url"],
          "properties": { "tag": { "type": "string" }, "url": { "type": "string" } }
        },
        "pageUrl": { "type": "string" }
      }
    }
  }
}
