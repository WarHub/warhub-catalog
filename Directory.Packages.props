<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- Pin transitive dependencies so security advisories can be resolved centrally -->
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <!-- Catalog tools -->
    <PackageVersion Include="Microsoft.Playwright" Version="1.61.0" />
    <PackageVersion Include="ReverseMarkdown" Version="6.1.0" />
    <PackageVersion Include="System.CommandLine" Version="3.0.0" />
    <PackageVersion Include="YamlDotNet" Version="18.1.0" />
    <!-- Publisher: JSON Schema authoring + validation of generated artifacts -->
    <PackageVersion Include="JsonSchema.Net" Version="9.7.0" />
    <!-- Publisher: the dist/catalog.sqlite query artifact -->
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="11.0.0" />
    <!-- Tests -->
    <PackageVersion Include="coverlet.collector" Version="10.1.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
  </ItemGroup>
</Project>
